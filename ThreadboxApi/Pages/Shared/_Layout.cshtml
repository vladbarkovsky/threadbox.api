@using Microsoft.Extensions.Options
@using ThreadboxApi.Configuration
@inject IOptionsMonitor<AppSettings> AppSettings
@{
    string culture = CultureInfo.CurrentUICulture.IetfLanguageTag;
}

<!doctype html>
<html lang="@culture" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="description" content="Anonymous imageboard for sharing texts and images." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Threadbox</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/98/98.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/98-overrides/themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/98-overrides/colors.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/98-overrides/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/98-overrides/sizes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/page.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login-page.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
</head>

<body data-information-cookie-domain="@AppSettings.CurrentValue.InformationCookieDomain">
    <header class="navbar">
        <a class="logo" href="~/">
            <img src="~/logo.png" asp-append-version="true" width="32" height="32" alt="@Localizer["Layout_Logo"]" />
            <span>Threadbox</span>
        </a>

        <button type="button" class="menu-button" aria-expanded="false" aria-controls="navbar-menu">@Localizer["Layout_Menu"]</button>

        <div id="navbar-menu" class="menu">
            <div class="language">
                <label for="language">@Localizer["Layout_Language"]</label>

                <select id="language">
                    <option value="en" selected="@(culture == "en" ? "selected" : null)">EN</option>
                    <option value="lv" selected="@(culture == "lv" ? "selected" : null)">LV</option>
                    <option value="ru" selected="@(culture == "ru" ? "selected" : null)">RU</option>
                </select>
            </div>

            <div class="vertical-bar" aria-hidden="true"></div>

            <div class="field-row theme">
                <input id="dark-theme" type="checkbox" />
                <label for="dark-theme">@Localizer["Layout_DarkTheme"]</label>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <script src="~/js/navbar.js" asp-append-version="true"></script>
</body>
</html>
