@page
@model LoginModel

<div class="login-page">
    <div class="window">
        <div class="title-bar">
            <div class="title-bar-text">@Localizer["Layout_SignIn"]</div>
        </div>

        <div class="window-body">
            <form method="post">
                <div class="field-row-stacked">
                    <label asp-for="Input.UserName"></label>
                    <input asp-for="Input.UserName" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.UserName"></span>
                </div>

                <div class="field-row-stacked">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" autocomplete="current-password" aria-required="true" type="password" />
                    <span asp-validation-for="Input.Password"></span>
                </div>

                <div class="field-row">
                    <input asp-for="Input.OfflineAccess" />
                    <label asp-for="Input.OfflineAccess"></label>
                </div>

                <div asp-validation-summary="ModelOnly"></div>

                <div class="field-row actions">
                    <button id="login-submit" type="submit" class="default">@Localizer["Layout_SignIn"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
